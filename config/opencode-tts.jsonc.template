{
  "enabled": true,
  "mode": "summary",
  "backend": "edge_tts",
  "edge_tts": {
    // Absolute path to the installed dispatcher (~/.local/bin on Linux,
    // /Users/you/.local/bin on macOS).  install.sh fills this in for you.
    "command": ["/home/you/.local/bin/opencode-tts-dispatch"],
    // Which VOICEVOX character speaks the Japanese/CJK half: "zundamon"
    // (default), "metan", "metan:sexy", "tsumugi", "hau", an edge-tts-shaped
    // name, or a bare style id.  `opencode-tts-voicevox --list-voices` lists
    // them.  English still goes through voiceger, which has one voice.
    "voice": "ja-JP-ZundamonNeural",
    "rate": "+25%",
    "volume": "+0%"
  }
}
