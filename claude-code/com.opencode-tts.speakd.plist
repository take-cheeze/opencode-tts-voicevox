<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  claude-tts-speakd: speaks text forwarded from Claude Code sessions on other
  machines. Belongs on the machine with the speakers, not the remote host.

  launchd does no variable expansion; install.sh substitutes @HOME@.
  Set CLAUDE_TTS_TOKEN here (and on the remote) if the remote host has other
  users -- they can all reach the forwarded loopback port. It is REQUIRED,
  not optional, once claude-code/setup-tunnel.sh exposes this port to the
  internet via Tailscale Funnel for Claude Code Web -- that script generates
  one and prints the edit to make here, then reload with:
    launchctl bootout gui/$(id -u)/com.opencode-tts.speakd
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.opencode-tts.speakd.plist
  ('launchctl kickstart -k' restarts the process but does NOT pick up a
  changed EnvironmentVariables block -- bootout+bootstrap does.)
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.opencode-tts.speakd</string>

  <key>ProgramArguments</key>
  <array>
    <string>@HOME@/.local/bin/claude-tts-speakd</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>@HOME@</string>
    <key>CLAUDE_TTS_PORT</key><string>17999</string>
    <key>CLAUDE_TTS_BIND</key><string>127.0.0.1</string>
    <!-- Summarizing happens here too, so a remote session needs no model.
         Prefer a self-hosted endpoint (CLAUDE_TTS_SUMMARY_URL /
         CLAUDE_TTS_SUMMARY_MODEL) so nothing leaves the machine; fall back to
         these two and it falls all the way to extractive truncation instead.
         opencode is a real API call through whatever provider it is
         authenticated with -- real cost, real quota -- opt-in for that
         reason. shutil.which("opencode") won't find it under launchd's bare
         PATH, so CLAUDE_TTS_OPENCODE_BIN is pinned explicitly. -->
    <!-- <key>CLAUDE_TTS_SUMMARY_URL</key><string>http://127.0.0.1:11434/v1</string> -->
    <!-- <key>CLAUDE_TTS_SUMMARY_MODEL</key><string>qwen2.5:1.5b</string> -->
    <key>CLAUDE_TTS_SUMMARY_OPENCODE</key><string>1</string>
    <key>CLAUDE_TTS_OPENCODE_BIN</key><string>@HOME@/.opencode/bin/opencode</string>
    <!-- <key>CLAUDE_TTS_TOKEN</key><string>REPLACE_ME</string> -->
  </dict>

  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key><false/>
  </dict>
  <key>ThrottleInterval</key><integer>5</integer>

  <key>StandardOutPath</key><string>@HOME@/Library/Logs/claude-tts-speakd.log</string>
  <key>StandardErrorPath</key><string>@HOME@/Library/Logs/claude-tts-speakd.log</string>
</dict>
</plist>
