<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  claude-tts-speakd: speaks text forwarded from Claude Code sessions on other
  machines. Belongs on the machine with the speakers, not the remote host.

  launchd does no variable expansion; install.sh substitutes @HOME@.
  Set CLAUDE_TTS_TOKEN here (and on the remote) if the remote host has other
  users -- they can all reach the forwarded loopback port.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.opencode-tts.speakd</string>

  <key>ProgramArguments</key>
  <array>
    <string>@HOME@/.local/bin/claude-tts-speakd</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>@HOME@</string>
    <key>CLAUDE_TTS_PORT</key><string>17999</string>
    <key>CLAUDE_TTS_BIND</key><string>127.0.0.1</string>
    <!-- Summarizing happens here too, so a remote session needs no model.
         A self-hosted endpoint keeps it that way: nothing leaves the machine.
         Unset these and it falls back to extractive truncation, never to an
         API provider unless CLAUDE_TTS_SUMMARY_CLAUDE=1 is set explicitly. -->
    <key>CLAUDE_TTS_SUMMARY_URL</key><string>http://127.0.0.1:11434/v1</string>
    <key>CLAUDE_TTS_SUMMARY_MODEL</key><string>qwen2.5:1.5b</string>
  </dict>

  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key><false/>
  </dict>
  <key>ThrottleInterval</key><integer>5</integer>

  <key>StandardOutPath</key><string>@HOME@/Library/Logs/claude-tts-speakd.log</string>
  <key>StandardErrorPath</key><string>@HOME@/Library/Logs/claude-tts-speakd.log</string>
</dict>
</plist>
