#!/usr/bin/env python3
"""Speak Claude Code's final response through the Zundamon TTS stack.

Wired up as a Stop hook: Claude Code writes the hook payload to stdin, we pull
the last assistant text out of the session transcript, reduce it to something
worth hearing, and hand it to opencode-tts-dispatch (CJK -> VOICEVOX, else
-> voiceger).

Optionally also a UserPromptSubmit hook (--user-prompt): speaks what *you*
typed, in a different VOICEVOX voice (CLAUDE_TTS_USER_VOICE) than whatever
speaks Claude's replies, so the two are never confusable. Since VOICEVOX only
understands Japanese, non-Japanese prompts are translated first with the same
self-hosted endpoint --summarize already uses -- no separate model to run.
UserPromptSubmit blocks prompt submission until the hook command exits (no
async support), so this mode does its real work in a detached child and
returns immediately.

Over SSH, the models and the speakers are on the machine you are sitting at,
not the one running Claude. If a claude-tts-speakd is reachable (normally
through `RemoteForward 17999 localhost:17999`), the *text* is sent there and
synthesis happens at that end -- so the remote host needs no models, no
voiceger, and no audio device.

The hook must never break the session, so every failure path exits 0 quietly.
Set CLAUDE_TTS_DEBUG=1 to send the reasons to stderr instead.

Environment:
  CLAUDE_TTS_DISPATCH   dispatcher path  (default ~/.local/bin/opencode-tts-dispatch)
  CLAUDE_TTS_SENTENCES  how many sentences to speak (default 2)
  CLAUDE_TTS_MAXCHARS   hard cap before truncating   (default 350)
  CLAUDE_TTS_RATE       speech rate passed through   (default +25%)
  CLAUDE_TTS_VOICE      which voice speaks (default ja-JP-ZundamonNeural);
                        `opencode-tts-voicevox --list-voices` prints the set
  CLAUDE_TTS_PLAYER     override the audio player command
  CLAUDE_TTS_FORWARD    receiver URL, or "off" to always speak locally;
                        unset auto-detects one on CLAUDE_TTS_FORWARD_PORT
  CLAUDE_TTS_FORWARD_PORT  loopback port to probe (default 17999)
  CLAUDE_TTS_TOKEN      shared secret, if the receiver requires one
  CLAUDE_TTS_SUMMARY_URL   comma-separated OpenAI-compatible endpoints, tried in
                        order, so summarizing can be offloaded to a beefier box
                        and still fall back when it is down. Each entry may
                        carry its own model after a "#":
                          http://gpubox:11434/v1#qwen2.5:7b,http://127.0.0.1:11434/v1
  CLAUDE_TTS_SUMMARY_MODEL default model for entries that do not name one
  CLAUDE_TTS_SUMMARY_CLAUDE 1 to fall back to the claude CLI (an API call);
                        off by default, so nothing leaves the machine
  CLAUDE_TTS_SUMMARIZER path to the claude CLI (default: found on PATH)
  CLAUDE_TTS_SUMMARY_OPENCODE 1 to fall back to `opencode run` (an API call
                        through whatever provider opencode is authenticated
                        with -- real cost, real quota); off by default, tried
                        after CLAUDE_TTS_SUMMARY_CLAUDE
  CLAUDE_TTS_OPENCODE_BIN path to the opencode CLI (default: found on PATH)
  CLAUDE_TTS_OPENCODE_MODEL provider/model for `opencode run -m`
                        (default: opencode-go/mimo-v2.5, the cheapest
                        opencode-go model that doesn't require opting into
                        data collection)
  CLAUDE_TTS_USER_VOICE which voice speaks your own prompts (--user-prompt);
                        unset disables the feature entirely, e.g. "metan"
  CLAUDE_TTS_TRANSLATE_TO target language for --translate  (default Japanese)
  CLAUDE_TTS_PROMPT_MAXCHARS cap on how much of a prompt gets spoken (default 200)
  CLAUDE_TTS_INHIBIT    1 to make this a no-op -- set on the summarizer child
                        so its own Stop hook cannot start a speak/summarize loop
  CLAUDE_TTS_DEBUG      1 to report why nothing was spoken
"""
import json
import os
import re
import shutil
import socket
import subprocess
import sys
import tempfile
import urllib.error
import urllib.parse
import urllib.request

HOME = os.path.expanduser("~")
DISPATCH = os.environ.get("CLAUDE_TTS_DISPATCH",
                          os.path.join(HOME, ".local/bin/opencode-tts-dispatch"))
SENTENCES = int(os.environ.get("CLAUDE_TTS_SENTENCES", "2"))
MAXCHARS = int(os.environ.get("CLAUDE_TTS_MAXCHARS", "350"))
RATE = os.environ.get("CLAUDE_TTS_RATE", "+25%")
VOICE = os.environ.get("CLAUDE_TTS_VOICE", "ja-JP-ZundamonNeural")
STATE = os.path.join(tempfile.gettempdir(), "claude-tts-speak.pid")
FORWARD = os.environ.get("CLAUDE_TTS_FORWARD", "")
FORWARD_PORT = os.environ.get("CLAUDE_TTS_FORWARD_PORT", "17999")
TOKEN = os.environ.get("CLAUDE_TTS_TOKEN", "")
NOTIFY_FALLBACK = os.environ.get("CLAUDE_TTS_NOTIFY_FALLBACK", "確認をお願いするのだ。")
NOTIFY_MAXCHARS = int(os.environ.get("CLAUDE_TTS_NOTIFY_MAXCHARS", "90"))
SUMMARY_TIMEOUT = float(os.environ.get("CLAUDE_TTS_SUMMARY_TIMEOUT", "90"))
USER_VOICE = os.environ.get("CLAUDE_TTS_USER_VOICE", "")
TRANSLATE_TO = os.environ.get("CLAUDE_TTS_TRANSLATE_TO", "Japanese")
PROMPT_MAXCHARS = int(os.environ.get("CLAUDE_TTS_PROMPT_MAXCHARS", "200"))
def _summary_endpoints():
    """[(url, model)] in preference order, from a comma-separated setting."""
    out = []
    for entry in os.environ.get("CLAUDE_TTS_SUMMARY_URL", "").split(","):
        entry = entry.strip()
        if not entry:
            continue
        url, _, model = entry.partition("#")
        out.append((url.rstrip("/"), model.strip()))
    return out


SUMMARY_ENDPOINTS = _summary_endpoints()
SUMMARY_MODEL = os.environ.get("CLAUDE_TTS_SUMMARY_MODEL", "")
SUMMARY_CLAUDE = os.environ.get("CLAUDE_TTS_SUMMARY_CLAUDE") == "1"
SUMMARIZER = os.environ.get("CLAUDE_TTS_SUMMARIZER") or shutil.which("claude")
SUMMARY_OPENCODE = os.environ.get("CLAUDE_TTS_SUMMARY_OPENCODE") == "1"
OPENCODE_BIN = os.environ.get("CLAUDE_TTS_OPENCODE_BIN") or shutil.which("opencode")
# Cheapest opencode-go model that doesn't require an explicit data-collection
# opt-in (muse-spark-1.2 is nominally cheaper but 403s without one) -- picked
# by $/token, not quality; override for anything more discerning.
OPENCODE_MODEL = os.environ.get("CLAUDE_TTS_OPENCODE_MODEL", "opencode-go/mimo-v2.5")
SUMMARY_PROMPT = (
    "Summarize the following assistant response as spoken audio copy in 2 short "
    "sentences. Keep concrete facts, decisions, and next actions. Do not mention "
    "that this is a summary. No markdown, no bullets, no preamble, plain text only."
)
TRANSLATE_PROMPT = (
    "Translate the following text into natural, casual spoken %s. Output ONLY "
    "the translation -- no romanization, no notes, no quotation marks, no "
    "preamble." % TRANSLATE_TO
)

# Terminators for both scripts; CJK stops double as sentence ends.
SENTENCE_END = re.compile(r"(?<=[.!?。！？])\s+|(?<=[。！？])")

# Kana / CJK Han / Hangul -- mirrors opencode-tts-dispatch's has_cjk(), kept
# local rather than imported since the two scripts ship and run independently.
def has_cjk(text):
    for ch in text:
        o = ord(ch)
        if 0x3040 <= o <= 0x30FF or 0x4E00 <= o <= 0x9FFF or 0xAC00 <= o <= 0xD7AF:
            return True
    return False


def debug(msg):
    if os.environ.get("CLAUDE_TTS_DEBUG") == "1":
        sys.stderr.write("claude-tts-speak: %s\n" % msg)


def is_real_user_turn(row):
    if "toolUseResult" in row:
        return False
    content = row.get("message", {}).get("content")
    if isinstance(content, str):
        return bool(content.strip())
    if isinstance(content, list):
        return any(b.get("type") == "text" for b in content)
    return False


def last_assistant_text(path):
    """Final assistant prose of the turn that just ended.

    Walks backwards to the newest text block, skipping tool_use/thinking and
    subagent (sidechain) rows, and stops at the user message that opened the
    turn so an older turn's text can never leak through.

    Tool results are also stored as type "user", so only a genuine user turn
    ends the walk -- otherwise the very first tool result would stop it.
    """
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            rows = [json.loads(line) for line in fh if line.strip()]
    except (OSError, ValueError) as exc:
        debug("cannot read transcript %s: %s" % (path, exc))
        return ""

    for row in reversed(rows):
        if row.get("isSidechain"):
            continue
        kind = row.get("type")
        if kind == "user":
            if is_real_user_turn(row):
                break
            continue
        if kind != "assistant":
            continue
        content = row.get("message", {}).get("content")
        if not isinstance(content, list):
            continue
        parts = [b.get("text", "") for b in content if b.get("type") == "text"]
        text = "\n".join(p for p in parts if p.strip())
        if text.strip():
            return text
    return ""


def strip_markdown(text):
    text = re.sub(r"```.*?```", " ", text, flags=re.S)      # fenced code
    text = re.sub(r"^\s*\|.*$", " ", text, flags=re.M)      # table rows
    text = re.sub(r"^\s{0,3}#{1,6}\s*", "", text, flags=re.M)
    text = re.sub(r"\[([^\]]+)\]\([^)]*\)", r"\1", text)    # links -> label
    text = re.sub(r"https?://\S+", " ", text)
    # Inline code: keep short identifiers, drop paths/flags/commands, which are
    # unlistenable read aloud.
    text = re.sub(r"`([^`]*)`",
                  lambda m: " " if re.search(r"[/\\_~*$]|^-|\s", m.group(1))
                  else m.group(1),
                  text)
    text = re.sub(r"[*_]{1,3}([^*_]+)[*_]{1,3}", r"\1", text)
    text = re.sub(r"^\s*[-*+]\s+", "", text, flags=re.M)    # bullets
    text = re.sub(r"^\s*\d+\.\s+", "", text, flags=re.M)
    text = re.sub(r"[\U0001F000-\U0001FAFF☀-➿]", " ", text)
    text = re.sub(r"[ \t]+", " ", text)
    return re.sub(r"\s*\n\s*", " ", text).strip()


def speakable(text):
    text = strip_markdown(text)
    if not text:
        return ""
    chunks = [c for c in SENTENCE_END.split(text) if c and c.strip()]
    out = " ".join(chunks[:SENTENCES]).strip()
    if len(out) > MAXCHARS:
        out = out[:MAXCHARS].rsplit(" ", 1)[0] + "."
    return out


def player_for(path):
    if os.environ.get("CLAUDE_TTS_PLAYER"):
        return os.environ["CLAUDE_TTS_PLAYER"].split() + [path]
    if sys.platform == "darwin" and shutil.which("afplay"):
        return ["afplay", path]
    for cmd in (["ffplay", "-nodisp", "-autoexit", "-loglevel", "quiet", path],
                ["mpg123", "-q", path],
                ["mpv", "--really-quiet", path]):
        if shutil.which(cmd[0]):
            return cmd
    return None


def stop_previous():
    """Barge-in: a new response supersedes whatever is still being read out."""
    try:
        with open(STATE) as fh:
            os.kill(int(fh.read().strip()), 15)
    except (OSError, ValueError):
        pass


def forward_target():
    """URL of a receiver that should speak for us, or None to speak locally.

    An explicit CLAUDE_TTS_FORWARD wins (and "off" forces local, which is how
    claude-tts-speakd stops its own children from bouncing straight back).
    Otherwise probe the loopback port an `ssh -R` would land on: if something
    answers there we are the remote end of a session and the audio belongs at
    the other end.
    """
    if FORWARD.lower() in ("off", "no", "0"):
        return None
    if FORWARD:
        return FORWARD.rstrip("/")
    url = "http://127.0.0.1:%s" % FORWARD_PORT
    try:
        req = urllib.request.Request(url + "/ping")
        with urllib.request.urlopen(req, timeout=0.5) as resp:
            if json.loads(resp.read().decode("utf-8")).get("ok"):
                return url
    except Exception:
        pass
    return None


def reachable(url, timeout=1.0):
    """Cheap TCP probe, so an offloaded box that is down costs a second, not a
    generation timeout. This one crashes regularly; skipping it must be fast."""
    try:
        parts = urllib.parse.urlsplit(url)
        port = parts.port or (443 if parts.scheme == "https" else 80)
        with socket.create_connection((parts.hostname, port), timeout=timeout):
            return True
    except OSError:
        return False


def summarize_via_api(text, url, model):
    """Summarize with a self-hosted OpenAI-compatible endpoint. None on failure.

    max_tokens is deliberately generous: a reasoning model spends its budget on
    reasoning_content first, and a tight cap returns an empty `content` with
    finish_reason "stop" -- success-shaped, useless.
    """
    body = json.dumps({
        "model": model or SUMMARY_MODEL or "default",
        "messages": [{"role": "user",
                      "content": SUMMARY_PROMPT + "\n\n" + text}],
        "max_tokens": 2048,
        "temperature": 0.3,
        "stream": False,
    }).encode("utf-8")
    req = urllib.request.Request(url + "/chat/completions", data=body,
                                 headers={"Content-Type": "application/json"},
                                 method="POST")
    try:
        with urllib.request.urlopen(req, timeout=SUMMARY_TIMEOUT) as resp:
            data = json.loads(resp.read().decode("utf-8"))
        out = (data["choices"][0]["message"].get("content") or "").strip()
        # Some local builds emit the chain of thought inline rather than in a
        # separate field.
        out = re.sub(r"<think>.*?</think>", " ", out, flags=re.S).strip()
        if out:
            return out
        debug("summary endpoint %s returned empty content" % url)
    except Exception as exc:
        debug("summary endpoint %s failed (%s)" % (url, exc))
    return None


def summarize_via_claude(text):
    if not SUMMARIZER or not os.path.isfile(SUMMARIZER):
        debug("no claude CLI for summarizing; truncating instead")
        return None
    env = dict(os.environ)
    # The summarizer is itself a claude session and will fire its own Stop
    # hook when it exits. Without this it would speak, and summarize, forever.
    env["CLAUDE_TTS_INHIBIT"] = "1"
    try:
        proc = subprocess.run([SUMMARIZER, "-p", SUMMARY_PROMPT],
                              input=text, capture_output=True, text=True,
                              env=env, timeout=SUMMARY_TIMEOUT)
        out = (proc.stdout or "").strip()
        if proc.returncode == 0 and out:
            return out
        debug("summarizer rc=%d" % proc.returncode)
    except (subprocess.TimeoutExpired, OSError) as exc:
        debug("summarizer failed (%s)" % exc)
    return None


def opencode_run(prompt, text):
    """Shell out to `opencode run`, an API call through whatever provider
    opencode is authenticated with. None on failure. Shared by summarize and
    translate: the invocation is identical, only the prompt differs.

    --format json rather than the default: default is written for a TTY (a
    live-updating spinner over ANSI escapes) and does not reliably deliver
    the final text over a plain pipe, so this parses the newline-delimited
    JSON event stream instead and keeps the "text" parts.
    """
    if not OPENCODE_BIN or not os.path.isfile(OPENCODE_BIN):
        debug("no opencode CLI for this backend")
        return None
    argv = [OPENCODE_BIN, "run", "--format", "json"]
    if OPENCODE_MODEL:
        argv += ["-m", OPENCODE_MODEL]
    argv.append(prompt + "\n\n" + text)
    try:
        proc = subprocess.run(argv, capture_output=True, text=True,
                              timeout=SUMMARY_TIMEOUT)
    except (subprocess.TimeoutExpired, OSError) as exc:
        debug("opencode CLI failed (%s)" % exc)
        return None
    if proc.returncode != 0:
        debug("opencode CLI rc=%d: %s" % (proc.returncode, (proc.stderr or "")[:200]))
        return None

    # A part's text is its current state, not a delta -- later events for the
    # same part id replace rather than append, same as the opencode plugin's
    # own message.part.updated handling.
    parts, order = {}, []
    for line in (proc.stdout or "").splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            ev = json.loads(line)
        except ValueError:
            continue
        if ev.get("type") != "text":
            continue
        part = ev.get("part") or {}
        pid = part.get("id")
        if pid not in parts:
            order.append(pid)
        parts[pid] = part.get("text", "")
    out = "\n".join(parts[pid] for pid in order if parts[pid].strip()).strip()
    if not out:
        debug("opencode CLI produced no text part")
    return out or None


def summarize(text):
    """Reduce a full response to speakable copy.

    Order matters: a self-hosted endpoint first, so nothing leaves the machine.
    The claude CLI is a real API call and stays opt-in. Extractive truncation is
    the floor -- a slightly clumsy sentence beats silence, and it needs nothing.
    """
    for url, model in SUMMARY_ENDPOINTS:
        if not reachable(url):
            debug("summary endpoint %s unreachable, skipping" % url)
            continue
        out = summarize_via_api(text, url, model)
        if out:
            debug("summarized via %s" % url)
            return speakable(out)
    if SUMMARY_CLAUDE:
        out = summarize_via_claude(text)
        if out:
            return speakable(out)
    if SUMMARY_OPENCODE:
        out = opencode_run(SUMMARY_PROMPT, text)
        if out:
            debug("summarized via opencode")
            return speakable(out)
    debug("no summarizer available; truncating")
    return speakable(text)


def translate_via_api(text, url, model):
    """Same self-hosted endpoint --summarize uses, different prompt. None on
    failure -- reuses summarize_via_api's request shape almost verbatim, but
    kept separate rather than parameterized: the two have different failure
    semantics (summarize falls back to truncation, translate falls back to
    silence), so sharing one function would just grow a branch for that."""
    body = json.dumps({
        "model": model or SUMMARY_MODEL or "default",
        "messages": [{"role": "user",
                      "content": TRANSLATE_PROMPT + "\n\n" + text}],
        "max_tokens": 1024,
        "temperature": 0.2,
        "stream": False,
    }).encode("utf-8")
    req = urllib.request.Request(url + "/chat/completions", data=body,
                                 headers={"Content-Type": "application/json"},
                                 method="POST")
    try:
        with urllib.request.urlopen(req, timeout=SUMMARY_TIMEOUT) as resp:
            data = json.loads(resp.read().decode("utf-8"))
        out = (data["choices"][0]["message"].get("content") or "").strip()
        out = re.sub(r"<think>.*?</think>", " ", out, flags=re.S).strip()
        out = out.strip("\"「」")  # some models wrap the answer in quotes anyway
        if out:
            return out
        debug("translate endpoint %s returned empty content" % url)
    except Exception as exc:
        debug("translate endpoint %s failed (%s)" % (url, exc))
    return None


def translate(text):
    """Japanese-ify text for a VOICEVOX voice, via the same self-hosted
    endpoint(s) as --summarize -- no separate model to run just for this.

    Unlike summarize(), there is no truncation fallback: Open JTalk
    mis-synthesizing English as if it were Japanese sounds like noise, and
    silence beats that.
    """
    if has_cjk(text):
        return text
    for url, model in SUMMARY_ENDPOINTS:
        if not reachable(url):
            debug("translate endpoint %s unreachable, skipping" % url)
            continue
        out = translate_via_api(text, url, model)
        if out and has_cjk(out):
            debug("translated via %s" % url)
            return out
        if out:
            # A small model asked to translate sometimes just answers in
            # English instead -- success-shaped, but not Japanese, and
            # speaking it would silently fall through to voiceger's single
            # English voice instead of the VOICEVOX one this was for.
            debug("translate endpoint %s returned non-Japanese output, "
                  "treating as failed: %r" % (url, out))
    if SUMMARY_OPENCODE:
        out = opencode_run(TRANSLATE_PROMPT, text)
        if out and has_cjk(out):
            debug("translated via opencode")
            return out
        if out:
            debug("opencode returned non-Japanese output, treating as "
                  "failed: %r" % out)
    debug("no translation endpoint available")
    return None


def forward(text, target, summarize_remotely=False, translate_remotely=False):
    """Hand the text to the receiver. True if it accepted responsibility."""
    body = json.dumps({"text": text, "rate": RATE, "voice": VOICE,
                       "summarize": bool(summarize_remotely),
                       "translate": bool(translate_remotely)}).encode("utf-8")
    headers = {"Content-Type": "application/json"}
    if TOKEN:
        headers["X-TTS-Token"] = TOKEN
    req = urllib.request.Request(target + "/speak", data=body,
                                 headers=headers, method="POST")
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            resp.read()
        return True
    except urllib.error.HTTPError as exc:
        debug("receiver at %s refused: HTTP %d" % (target, exc.code))
    except Exception as exc:
        debug("cannot forward to %s: %s" % (target, exc))
    return False


def speak_local(text):
    if not os.path.isfile(DISPATCH):
        debug("dispatcher not found at %s" % DISPATCH)
        return

    fd, out = tempfile.mkstemp(suffix=".mp3", prefix="claude-tts-")
    os.close(fd)
    try:
        subprocess.run([DISPATCH, "--voice", VOICE,
                        "--rate", RATE, "--volume", "+0%",
                        "--text", text, "--write-media", out],
                       check=True, stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL if not
                       os.environ.get("CLAUDE_TTS_DEBUG") else None)
        cmd = player_for(out)
        if not cmd:
            debug("no audio player found (afplay/ffplay/mpg123/mpv)")
            return
        stop_previous()
        proc = subprocess.Popen(cmd, stdout=subprocess.DEVNULL,
                                stderr=subprocess.DEVNULL)
        with open(STATE, "w") as fh:
            fh.write(str(proc.pid))
        proc.wait()
    except (subprocess.CalledProcessError, OSError) as exc:
        debug("synthesis or playback failed: %s" % exc)
    finally:
        try:
            os.remove(out)
        except OSError:
            pass


def text_from_notification():
    """Turn a Notification hook payload into something worth hearing.

    Claude Code sends this when it is waiting on you -- a question, or a
    permission prompt. The payload wording is the informative part, so speak it
    rather than a fixed phrase, but keep it short: this is an alert, and a long
    English sentence takes ten seconds to synthesize.
    """
    try:
        payload = json.load(sys.stdin)
    except (ValueError, OSError):
        payload = {}
    if os.environ.get("CLAUDE_TTS_DEBUG") == "1":
        # The exact shape is not documented; keep a copy to refine against.
        try:
            with open(os.path.join(tempfile.gettempdir(),
                                   "claude-tts-notify.json"), "w") as fh:
                json.dump(payload, fh, ensure_ascii=False, indent=2)
        except OSError:
            pass

    msg = ""
    for key in ("message", "title", "body", "notification", "reason"):
        val = payload.get(key)
        if isinstance(val, str) and val.strip():
            msg = val.strip()
            break
    if not msg:
        tool = payload.get("tool_name") or ""
        msg = ("%s の確認をお願いするのだ。" % tool) if tool else NOTIFY_FALLBACK

    msg = re.sub(r"\s+", " ", msg).strip()
    if len(msg) > NOTIFY_MAXCHARS:
        msg = msg[:NOTIFY_MAXCHARS].rsplit(" ", 1)[0]
    return msg


def speak_user_prompt():
    """UserPromptSubmit entry point.

    This hook has no async support -- Claude Code waits for the command to
    exit before your turn starts -- so the real work (translate, synthesize,
    play) happens in a detached child, and this returns in well under the
    time a python3 interpreter takes to start. It must also print nothing:
    Claude Code folds a UserPromptSubmit hook's stdout into the turn's
    context, which is not where a debug line belongs.
    """
    if not USER_VOICE:
        return  # feature is off unless a distinct voice is configured
    try:
        payload = json.load(sys.stdin)
    except (ValueError, OSError):
        payload = {}
    text = (payload.get("prompt") or "").strip()
    if not text:
        return
    text = re.sub(r"\s+", " ", text)[:PROMPT_MAXCHARS]

    env = dict(os.environ)
    env["CLAUDE_TTS_VOICE"] = USER_VOICE
    try:
        subprocess.Popen(
            [sys.executable, os.path.abspath(__file__), "--translate",
             "--text", text],
            env=env, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError as exc:
        debug("could not detach user-prompt speaker: %s" % exc)


def text_from_hook():
    try:
        payload = json.load(sys.stdin)
    except (ValueError, OSError):
        payload = {}

    transcript = payload.get("transcript_path")
    if not transcript or not os.path.isfile(transcript):
        debug("no transcript_path in hook payload")
        return ""
    return speakable(last_assistant_text(transcript))


def main():
    if os.environ.get("CLAUDE_TTS_INHIBIT") == "1":
        # We are inside the summarizer's own claude session; speaking here is
        # what would turn one summary into an endless chain of them.
        debug("inhibited")
        return

    # --text speaks the given words directly; that is how claude-tts-speakd
    # re-enters this script after receiving a forwarded request, and how
    # speak_user_prompt()'s detached child re-enters it too.
    # --summarize first reduces them with the claude CLI, wherever the audio is.
    # --translate Japanese-ifies them for a VOICEVOX voice, same endpoint.
    argv = sys.argv[1:]
    want_summary = False
    if "--summarize" in argv:
        want_summary = True
        argv = [a for a in argv if a != "--summarize"]
    want_translate = False
    if "--translate" in argv:
        want_translate = True
        argv = [a for a in argv if a != "--translate"]

    if argv and argv[0] == "--user-prompt":
        return speak_user_prompt()
    if argv and argv[0] == "--notify":
        text = text_from_notification()
    elif len(argv) > 1 and argv[0] == "--text":
        text = " ".join(argv[1:]).strip()
    elif argv:
        sys.stderr.write("usage: claude-tts-speak [--summarize] [--translate] "
                         "[--text WORDS | --notify | --user-prompt]   "
                         "(Stop hook payload on stdin otherwise)\n")
        return
    else:
        text = text_from_hook()

    if not text:
        debug("nothing speakable in the last assistant message")
        return

    target = forward_target()
    if target:
        # Summarizing and translating both happen at the receiver, so the
        # sending host needs no model -- the same reason synthesis does.
        if forward(text, target, summarize_remotely=want_summary,
                   translate_remotely=want_translate):
            debug("forwarded to %s (summarize=%s translate=%s)"
                  % (target, want_summary, want_translate))
            return

    if want_translate:
        text = translate(text)
        if not text:
            debug("translation unavailable or failed")
            return
    if want_summary:
        text = summarize(text)
        if not text:
            debug("summary was empty")
            return
    speak_local(text)


if __name__ == "__main__":
    try:
        main()
    except Exception as exc:                      # never break the session
        debug("unexpected: %r" % exc)
    sys.exit(0)
