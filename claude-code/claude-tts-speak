# Function words worth skipping when picking keywords out of the omitted
# text -- short and English-only on purpose: the input here is always the
# pre-translation source text (see speakable()'s call site in text_from_hook),
# and stripping every function word a general list would is unnecessary for
# what is, in practice, Claude's own assistant prose.
STOPWORDS = frozenset("""
the a an is was were be been being to of and or but if then so because as
at by for with about against between into through during before after
above below from up down in out on off over under again further once
here there when where why how all any both each few more most other some
such no nor not only own same than too very can will just should now this
that these those i you he she it we they them their its his her my your
our what which who whom do does did doing have has had having would could
also like get gets got one two first second new use used using
""".split())


def _identifier_score(word):
    """Higher = more likely a proper noun/acronym/identifier (API, Docker,
    GitHub) rather than an ordinary long word (specifically, sentence) that
    just happens to survive the stopword filter. Casing is the cheapest
    signal available without a real tagger: short ALL-CAPS reads as an
    acronym, any other capital (leading or embedded, i.e. also catches
    camelCase) reads as a name -- ordinary words are lowercase."""
    if word.isupper() and 2 <= len(word) <= 6:
        return 2
    if any(c.isupper() for c in word):
        return 1
    return 0


def extract_keywords(text, exclude, limit):
    """Distinctive words from `text`, ranked by identifier-likeness (see
    _identifier_score) then frequency then length, skipping anything in
    `exclude` (already spoken) or STOPWORDS.

    CJK has no whitespace to split on -- a real tokenizer is not worth it for
    a "free" fallback feature, so this only ever looks at the Latin-script
    identifiers/acronyms that make up most of a technical assistant reply
    (translation happens after this, on the whole trimmed+suffixed string).
    """
    if not text or not limit:
        return []
    words = re.findall(r"[A-Za-z][A-Za-z0-9_]{2,}", text)
    freq = {}
    first_form = {}
    order = []
    for w in words:
        key = w.lower()
        first_form.setdefault(key, w)
        if key in STOPWORDS or key in exclude:
            continue
        if key not in freq:
            order.append(key)
        freq[key] = freq.get(key, 0) + 1
    ranked = sorted(order, key=lambda k: (
        -_identifier_score(first_form[k]), -freq[k], -len(k)))
    return [first_form[k] for k in ranked[:limit]]


def _summary_endpoints():
    """[(url, model)] in preference order, from a comma-separated setting."""
    out = []
    for entry in os.environ.get("CLAUDE_TTS_SUMMARY_URL", "").split(","):
        entry = entry.strip()
        if not entry:
            continue
        url, _, model = entry.partition("#")
        out.append((url.rstrip("/"), model.strip()))
    return out


