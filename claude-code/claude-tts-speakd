#!/usr/bin/env python3
"""Speak text sent by a Claude Code session running on another machine.

Runs on the machine you are actually sitting at -- the one with the models and
the speakers. A Claude Code session on a remote host POSTs the text here
through an SSH reverse tunnel, so the remote host needs no VOICEVOX assets, no
voiceger, and no audio device:

    # ~/.ssh/config, on this machine
    Host remote
      RemoteForward 17999 localhost:17999

    remote:  claude-tts-speak  ──POST /speak──►  127.0.0.1:17999
                                                   │ (ssh -R)
    here:    claude-tts-speakd ◄───────────────────┘
                    └─► claude-tts-speak --text ... ─► dispatcher ─► speakers

Endpoints:
    GET  /ping    -> {"ok": true, ...}
    POST /speak   {"text":"...", "rate":"+25%", "voice":"...", "summarize":bool,
                   "translate":bool} -> 202 {"ok": true}
    POST /synth   {"text": "...", "rate": "+25%", "voice": "..."} -> 200 audio/mpeg

/speak plays here and is what the Claude Code hook uses. /synth hands the
audio back instead, for callers that do their own playback -- opencode-tts
runs the dispatcher for a file and then plays it, and on a host with
PULSE_SERVER forwarded that playback already lands on these speakers.

Bound to loopback only. On a *shared* remote host every local user can reach
the forwarded port, so set CLAUDE_TTS_TOKEN at both ends there.

Environment:
  CLAUDE_TTS_PORT     listen port          (default 17999)
  CLAUDE_TTS_BIND     listen address       (default 127.0.0.1)
  CLAUDE_TTS_SPEAK    speak script path    (default ~/.local/bin/claude-tts-speak)
  CLAUDE_TTS_TOKEN    require this shared secret in X-TTS-Token
  CLAUDE_TTS_MAXBYTES reject bodies larger than this (default 131072)
  CLAUDE_TTS_COLLECT_UNKNOWN  collect unknown jargon as dictionary
                            candidates (default on; 0 disables)
  CLAUDE_TTS_UNKNOWN_WORDS    candidate words file (see above)
  CLAUDE_TTS_AUTO_DICT        1 (default) to also run
                            voicevox/import-candidates.py --auto-apply on
                            newly-collected words (throttled), so the
                            dictionary grows on its own; 0 to only log
                            candidates, as before. See claude-tts-speak's
                            docstring for the full explanation.
  CLAUDE_TTS_AUTO_DICT_COOLDOWN  minimum seconds between auto-dict rebuilds
                            (default 600)
  CLAUDE_TTS_AUTO_DICT_SCRIPT path to import-candidates.py; unset finds it
                            next to the VOICEVOX_DIR baked into the
                            installed opencode-tts-voicevox shim
"""
import json
import os
import re
import shutil
import subprocess
import time
import unicodedata
import sys
import tempfile
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

HOME = os.path.expanduser("~")
PORT = int(os.environ.get("CLAUDE_TTS_PORT", "17999"))
BIND = os.environ.get("CLAUDE_TTS_BIND", "127.0.0.1")
SPEAK = os.environ.get("CLAUDE_TTS_SPEAK",
                       os.path.join(HOME, ".local/bin/claude-tts-speak"))
DISPATCH = os.environ.get("CLAUDE_TTS_DISPATCH",
                          os.path.join(HOME, ".local/bin/opencode-tts-dispatch"))
TOKEN = os.environ.get("CLAUDE_TTS_TOKEN", "")
# Summarize requests carry a whole assistant response, not a sentence, so the
# cap has to fit one. Still bounded: this port is reachable by any local user
# on a shared remote host.
MAXBYTES = int(os.environ.get("CLAUDE_TTS_MAXBYTES", "131072"))
# Collect dev jargon Open JTalk does not know (it is not in the compiled user
# dict) into a plain list the user can review and turn into real dictionary
# entries. On by default so it just works; set to 0 to never write the file.
COLLECT_UNKNOWN = os.environ.get("CLAUDE_TTS_COLLECT_UNKNOWN") != "0"
UNKNOWN_WORDS = os.environ.get(
    "CLAUDE_TTS_UNKNOWN_WORDS",
    os.path.join(HOME, ".local/share/opencode-tts-speakd/unknown_words.txt"))
# Same auto-dictionary-growth trigger claude-tts-speak runs for the local
# (no forwarding) path -- see its docstring. Kept in sync here so a
# forwarding setup (the reason this daemon exists at all) gets it too.
AUTO_DICT = os.environ.get("CLAUDE_TTS_AUTO_DICT", "1") != "0"
AUTO_DICT_COOLDOWN = float(os.environ.get("CLAUDE_TTS_AUTO_DICT_COOLDOWN", "600"))
AUTO_DICT_STAMP = os.path.join(tempfile.gettempdir(), "claude-tts-auto-dict.stamp")


def usable_path():
    """PATH for children, rebuilt rather than inherited.

    launchd hands an agent a bare PATH (/usr/bin:/bin:/usr/sbin:/sbin), so the
    dispatcher we spawn cannot find ffmpeg and synthesis fails with a bare
    "command not found". Name the prefixes explicitly instead of assuming a
    login shell ran.
    """
    parts = [p for p in os.environ.get("PATH", "").split(os.pathsep) if p]
    for extra in (os.path.join(HOME, ".nix-profile/bin"), "/opt/homebrew/bin",
                  "/usr/local/bin", os.path.join(HOME, ".local/bin")):
        if os.path.isdir(extra) and extra not in parts:
            parts.insert(0, extra)
    return os.pathsep.join(parts)


def child_env(extra=None):
    """Environment for anything we spawn.

    Both layers can forward, and both probe the port this daemon serves. Left
    unset, a child would discover us and hand the work straight back, which is
    an infinite loop rather than a slow path.
    """
    env = dict(os.environ)
    env["PATH"] = usable_path()
    env["CLAUDE_TTS_FORWARD"] = "off"     # claude-tts-speak
    env["TTS_FORWARD"] = "off"            # opencode-tts-dispatch
    if extra:
        env.update(extra)
    return env


_CJK = re.compile(r"[\u3040-\u30ff\u4e00-\u9fff\uAC00-\uD7AF]")
_IDENTIFIER = re.compile(r"[A-Za-z][A-Za-z0-9_]{2,}")


def has_cjk(text):
    """True if text carries kana / CJK Han / Hangul -- the signal that the text
    will be spoken by VOICEVOX, where the pronunciation dictionary applies."""
    return bool(_CJK.search(text))


def _lower(words):
    return {w.lower() for w in words}


def _surface(word):
    """Canonicalize a dictionary surface for comparison with spoken text.

    A compiled VOICEVOX dict stores surfaces in fullwidth Latin (Open JTalk
    width-normalizes them on write); the text actually spoken, and the TSV the
    user edits, use ASCII. NFKC maps the two onto each other so a known word is
    not mistaken for an unknown one.
    """
    return unicodedata.normalize("NFKC", word).strip()


def _dict_surface_words(path):
    """Surface words already in a compiled VOICEVOX dict, whichever form it is.

    Accepts the JSON --build-user-dict emits (a list of {surface, ...} objects)
    or a raw user_dict_terms.tsv (first column). Used so a word we already know
    about is never re-recorded as "unknown" on every speak.
    """
    try:
        with open(path, encoding="utf-8") as fh:
            text = fh.read()
    except (OSError, UnicodeDecodeError):
        return set()
    if path.endswith(".json"):
        try:
            data = json.loads(text)
        except ValueError:
            return set()
        # --build-user-dict emits a list of entries; a saved VOICEVOX dictionary
        # is a dict keyed by UUID with the same entry objects as values.
        if isinstance(data, dict):
            data = list(data.values())
        if isinstance(data, list):
            return {_surface(e["surface"]) for e in data
                    if isinstance(e, dict) and e.get("surface")}
        return set()
    words = set()
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "\t" not in line:
            continue
        words.add(_surface(line.split("\t")[0]))
    return words


_SHIM_WORDS_CACHE = None


def _shim_dict_path():
    """user_dict.json the installed opencode-tts-voicevox shim actually loads.

    The daemon runs under launchd/systemd with no VOICEVOX_DIR, but the shim it
    spawns has the asset dir baked into its binary at build time; scan for the
    absolute path that ends in /assets (the VOICEVOX_DIR layout) and read
    <dir>/user_dict.json from there, so collection dedupes against the real
    dictionary even with a bare environment.
    """
    shim = os.path.join(os.path.dirname(DISPATCH), "opencode-tts-voicevox")
    if not os.path.isfile(shim):
        shim = shutil.which("opencode-tts-voicevox")
    if not shim:
        shim = os.path.join(HOME, ".local/bin/opencode-tts-voicevox")
    try:
        data = open(shim, "rb").read()
    except OSError:
        return None
    for tok in re.finditer(rb"[\x21-\x7e]{4,}", data):
        s = tok.group().decode("latin-1")
        if s.startswith("/") and "voicevox" in s and "assets" in s:
            p = os.path.join(s, "user_dict.json")
            if os.path.isfile(p):
                return p
    return None


def known_words():
    """Words already in the user dict, from (in order) $VOICEVOX_USER_DICT,
    $VOICEVOX_DIR/user_dict.json, a $CLAUDE_TTS_DICT_TSV, and finally the dict
    the installed shim itself loads. Memoized: the daemon lives forever and the
    dictionary does not change under it, so scan the binary at most once.
    Empty set if nothing is found -- collection still works, it just may repeat
    a word later."""
    global _SHIM_WORDS_CACHE
    if _SHIM_WORDS_CACHE is not None:
        return _SHIM_WORDS_CACHE
    paths = []
    ud = os.environ.get("VOICEVOX_USER_DICT")
    if ud:
        paths.append(ud)
    vdir = os.environ.get("VOICEVOX_DIR")
    if vdir:
        paths.append(os.path.join(vdir, "user_dict.json"))
    tsv = os.environ.get("CLAUDE_TTS_DICT_TSV")
    if tsv:
        paths.append(tsv)
    shim_path = _shim_dict_path()
    if shim_path:
        paths.append(shim_path)
    words = set()
    for p in paths:
        if p and os.path.isfile(p):
            words |= _dict_surface_words(p)
    _SHIM_WORDS_CACHE = words
    return words


def unknown_candidates(text):
    """Identifier-like words in `text` that are not in the dict yet.

    CJK-only (the dictionary is a VOICEVOX concern) and identifier-shaped
    (any capital letter, which is how acronyms and proper nouns read --
    ordinary lowercase prose words do not qualify), so the list stays full of
    the dev jargon Open JTalk would otherwise spell out letter by letter.
    """
    if not has_cjk(text):
        return []
    known_low = _lower(known_words())
    seen = set()
    out = []
    for word in _IDENTIFIER.findall(text):
        key = word.lower()
        if key in seen or key in known_low:
            continue
        seen.add(key)
        out.append(word)
    return out


def _auto_dict_script():
    """Absolute path to voicevox/import-candidates.py, found next to the
    VOICEVOX_DIR baked into the installed opencode-tts-voicevox shim -- same
    scan as _shim_dict_path() above, for a sibling file instead of the
    compiled dict itself."""
    override = os.environ.get("CLAUDE_TTS_AUTO_DICT_SCRIPT")
    if override:
        return override
    shim = os.path.join(os.path.dirname(DISPATCH), "opencode-tts-voicevox")
    if not os.path.isfile(shim):
        shim = shutil.which("opencode-tts-voicevox")
    if not shim:
        shim = os.path.join(HOME, ".local/bin/opencode-tts-voicevox")
    try:
        data = open(shim, "rb").read()
    except OSError:
        return None
    for tok in re.finditer(rb"[\x21-\x7e]{4,}", data):
        s = tok.group().decode("latin-1")
        if s.startswith("/") and "voicevox" in s and s.endswith("assets"):
            candidate = os.path.join(os.path.dirname(s), "import-candidates.py")
            if os.path.isfile(candidate):
                return candidate
    return None


def maybe_refresh_dictionary():
    """Throttled: run import-candidates.py --auto-apply in the background."""
    if not AUTO_DICT:
        return
    try:
        due = time.time() - os.path.getmtime(AUTO_DICT_STAMP) >= AUTO_DICT_COOLDOWN
    except OSError:
        due = True
    if not due:
        return
    script = _auto_dict_script()
    if not script:
        return
    try:
        open(AUTO_DICT_STAMP, "w").close()
        subprocess.Popen([sys.executable, script, "--auto-apply"],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        pass


def collect_unknown_words(text):
    """Append unknown jargon in `text` to UNKNOWN_WORDS as dictionary
    candidates, then (throttled) trigger a dictionary auto-refresh.

    Never raises: a failure here must never stop a speak.
    """
    if not COLLECT_UNKNOWN or not text:
        return
    new = []
    existing = set()
    if os.path.isfile(UNKNOWN_WORDS):
        try:
            with open(UNKNOWN_WORDS, encoding="utf-8") as fh:
                existing = _lower(ln.strip() for ln in fh if ln.strip())
        except (OSError, UnicodeDecodeError):
            existing = set()
    for word in unknown_candidates(text):
        if word.lower() not in existing:
            new.append(word)
    if new:
        try:
            os.makedirs(os.path.dirname(UNKNOWN_WORDS) or ".", exist_ok=True)
            with open(UNKNOWN_WORDS, "a", encoding="utf-8") as fh:
                for word in new:
                    fh.write(word + "\n")
            sys.stderr.write("claude-tts-speakd: recorded %d unknown word(s) "
                             "for the dictionary at %s\n" % (len(new), UNKNOWN_WORDS))
            sys.stderr.flush()
        except OSError as exc:
            sys.stderr.write("claude-tts-speakd: cannot write unknown words %s: "
                             "%s\n" % (exc, UNKNOWN_WORDS))
            sys.stderr.flush()
    maybe_refresh_dictionary()


class Handler(BaseHTTPRequestHandler):
    server_version = "claude-tts-speakd"

    def log_message(self, fmt, *args):        # quiet unless something failed
        pass

    def _bytes(self, code, ctype, payload):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(payload)))
        self.end_headers()
        self.wfile.write(payload)

    def _json(self, code, obj):
        body = json.dumps(obj).encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if self.path.rstrip("/") != "/ping":
            return self._json(404, {"ok": False, "error": "not found"})
        self._json(200, {"ok": True, "service": "claude-tts-speakd",
                         "auth": bool(TOKEN)})

    def _read_request(self):
        """Shared validation. Returns the parsed body, or None after replying."""
        if TOKEN and self.headers.get("X-TTS-Token") != TOKEN:
            self._json(403, {"ok": False, "error": "bad token"})
            return None
        try:
            length = int(self.headers.get("Content-Length", "0"))
        except ValueError:
            length = 0
        if length <= 0 or length > MAXBYTES:
            self._json(413, {"ok": False, "error": "bad length"})
            return None
        try:
            req = json.loads(self.rfile.read(length).decode("utf-8"))
        except (ValueError, UnicodeDecodeError):
            self._json(400, {"ok": False, "error": "bad json"})
            return None
        if not (req.get("text") or "").strip():
            self._json(400, {"ok": False, "error": "no text"})
            return None
        return req

    def do_POST(self):
        route = self.path.rstrip("/")
        if route == "/synth":
            return self.do_synth()
        if route != "/speak":
            return self._json(404, {"ok": False, "error": "not found"})
        if TOKEN and self.headers.get("X-TTS-Token") != TOKEN:
            return self._json(403, {"ok": False, "error": "bad token"})

        try:
            length = int(self.headers.get("Content-Length", "0"))
        except ValueError:
            length = 0
        if length <= 0 or length > MAXBYTES:
            return self._json(413, {"ok": False, "error": "bad length"})

        try:
            req = json.loads(self.rfile.read(length).decode("utf-8"))
            text = (req.get("text") or "").strip()
        except (ValueError, UnicodeDecodeError):
            return self._json(400, {"ok": False, "error": "bad json"})
        if not text:
            return self._json(400, {"ok": False, "error": "no text"})

        # Record jargon Open JTalk does not know so it can be added to the
        # user dictionary later; this host is where the dictionary lives.
        collect_unknown_words(text)

        env = child_env()
        if req.get("rate"):
            env["CLAUDE_TTS_RATE"] = str(req["rate"])
        # The far end picked the voice; speaking it in a different one here
        # would be a surprise.
        if req.get("voice"):
            env["CLAUDE_TTS_VOICE"] = str(req["voice"])
        # Summarizing runs here too, so a remote session needs no model of
        # its own -- the same reason synthesis runs here.
        argv = [SPEAK]
        if req.get("summarize"):
            argv.append("--summarize")
        if req.get("translate"):
            argv.append("--translate")
        argv += ["--text", text]
        try:
            # Detached: answer immediately so the remote turn is never held
            # open for the length of the audio.
            subprocess.Popen(argv, env=env,
                             stdout=subprocess.DEVNULL,
                             stderr=None if os.environ.get("CLAUDE_TTS_DEBUG")
                             else subprocess.DEVNULL)
        except OSError as exc:
            return self._json(500, {"ok": False, "error": str(exc)})
        self._json(202, {"ok": True})

    def do_synth(self):
        """Synthesize here and hand the audio back; the caller plays it."""
        req = self._read_request()
        if req is None:
            return
        if not os.path.isfile(DISPATCH):
            return self._json(500, {"ok": False,
                                    "error": "no dispatcher at %s" % DISPATCH})

        fd, out = tempfile.mkstemp(suffix=".mp3", prefix="claude-tts-synth-")
        os.close(fd)
        try:
            proc = subprocess.run(
                [DISPATCH,
                 "--voice", str(req.get("voice") or "ja-JP-ZundamonNeural"),
                 "--rate", str(req.get("rate") or "+0%"),
                 "--volume", str(req.get("volume") or "+0%"),
                 "--text", req["text"], "--write-media", out],
                env=child_env(), stdout=subprocess.DEVNULL,
                stderr=subprocess.PIPE)
            if proc.returncode != 0:
                detail = proc.stderr.decode("utf-8", "replace").strip()
                return self._json(502, {"ok": False, "error": detail[:400]})
            with open(out, "rb") as fh:
                audio = fh.read()
            if not audio:
                return self._json(502, {"ok": False, "error": "empty audio"})
            self._bytes(200, "audio/mpeg", audio)
        except OSError as exc:
            self._json(500, {"ok": False, "error": str(exc)})
        finally:
            try:
                os.remove(out)
            except OSError:
                pass


def main():
    if not os.path.isfile(SPEAK):
        sys.stderr.write("claude-tts-speakd: no speak script at %s\n" % SPEAK)
        return 1
    srv = ThreadingHTTPServer((BIND, PORT), Handler)
    srv.daemon_threads = True
    sys.stderr.write("claude-tts-speakd: listening on %s:%d%s\n"
                     % (BIND, PORT, " (token required)" if TOKEN else ""))
    sys.stderr.flush()
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
